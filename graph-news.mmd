---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	assess_one(assess_one)
	rank(rank)
	judge_one(judge_one)
	collect(collect)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> assess_one;
	__start__ -.-> rank;
	assess_one --> rank;
	judge_one --> collect;
	rank -.-> collect;
	rank -.-> judge_one;
	collect --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
